<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.impl.portal.Screenshot:
      @short_description: Audio Portal backend interface

      This screenshot portal lets sandboxed applications request access to
      audio devices.

      This documentation describes version 1 of this interface.
  -->
  <interface name="org.freedesktop.impl.portal.Audio">
    <!--
        RequestInputDevices:
        @handle: Object path for the :ref:`org.freedesktop.impl.portal.Request` object representing this call
        @app_id: App id of the application
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @response: Numeric response
        @results: Vardict with the results of the call

        Request the user to select which audio input device nodes the
        application can see.

        Supported keys in the @options vardict include:

        * ``mode`` (``u``)

          The audio input devices to request access to. It is a single target value, not a bitmask, and
          must be one of the targets advertised in AvailableInputModes. If this option
          is omitted, DEFAULT will be used.

          - ``1``: DEFAULT: Request access to only the default input device.
          - ``2``: SELECTION: Request access to selection of input devices in the system.
    -->
    <method name="RequestInputDevices">
      <arg type="s" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>

    <!--
        RequestOutputDevices:
        @handle: Object path for the :ref:`org.freedesktop.impl.portal.Request` object representing this call
        @app_id: App id of the application
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @response: Numeric response
        @results: Vardict with the results of the call

        Request the user to select which audio output device nodes the
        application can see.

        Supported keys in the @options vardict include:
    -->
    <method name="RequestOutputDevices">
      <arg type="s" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
