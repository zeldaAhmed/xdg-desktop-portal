<node name="/" xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
  <!--
      org.freedesktop.portal.Audio:
      @short_description: Portal for audio devices

      The audio portal allows for accessing physical audio devices.
      TODO LONGER DESC OF PORTAL IFACE

      This documentation describes version 1 of this interface.
  -->
  <interface name="org.freedesktop.portal.Audio">
    <!--
        RequestInputDevices:
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @handle: Object path for the :ref:`org.freedesktop.portal.Request` object representing this call

        Request the user to select which audio input device nodes the
        application can see.

        Following the :ref:`org.freedesktop.portal.Request::Response` signal, if
        access is granted, :ref:`org.freedesktop.portal.Audio.OpenPipeWireRemote`
        can be used to open a PipeWire remote with the audio input device nodes.

        Supported keys in the @options vardict include:

        * ``handle_token`` (``s``)

          A string that will be used as the last element of the @handle. Must be a valid
          object path element. See the :ref:`org.freedesktop.portal.Request` documentation for
          more information about the @handle.

        * ``mode`` (``u``)

          The audio input devices to request access to. It is a single target value, not a bitmask, and
          must be one of the targets advertised in AvailableInputModes. If this option
          is omitted, DEFAULT will be used.

          - ``1``: DEFAULT: Request access to only the default input device.
          - ``2``: SELECTION: Request access to selection of input devices in the system.
    -->
    <method name="RequestInputDevices">
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="handle" direction="out"/>
    </method>

    <!--
        RequestOutputDevices:
        @parent_window: Identifier for the application window, see :doc:`window-identifiers`
        @options: Vardict with optional further information
        @handle: Object path for the :ref:`org.freedesktop.portal.Request` object representing this call

        Request the user to select which audio output device nodes the
        application can see.

        Following the :ref:`org.freedesktop.portal.Request::Response` signal, if
        access is granted, :ref:`org.freedesktop.portal.Audio.OpenPipeWireRemote`
        can be used to open a PipeWire remote with the audio output device nodes.

        Supported keys in the @options vardict include:

        * ``handle_token`` (``s``)

          A string that will be used as the last element of the @handle. Must be a valid
          object path element. See the :ref:`org.freedesktop.portal.Request` documentation for
          more information about the @handle.
    -->
    <method name="RequestOutputDevices">
      <arg type="s" name="parent_window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="o" name="handle" direction="out"/>
    </method>

    <!--
        OpenPipeWireRemote:
        @options: Vardict with optional further information
        @fd: File descriptor of an open PipeWire remote.

        Open a file descriptor to the PipeWire remote where the selected audio
        device nodes are available. The file descriptor should be used to create a
        ``pw_core`` object, by using ``pw_context_connect_fd``. Only audio
        device nodes will be available from this PipeWire remote.
    -->
    <method name="OpenPipeWireRemote">
      <annotation name="org.gtk.GDBus.C.Name" value="open_pipewire_remote"/>
      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="h" name="fd" direction="out"/>
    </method>

    <property name="version" type="u" access="read"/>
  </interface>
</node>
